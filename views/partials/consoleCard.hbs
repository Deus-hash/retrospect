<a href="/consoles/{{this.slug}}" class="console-card" style="--console-color: {{this.color}};">
  <div class="console-card__image">
    <img src="{{this.image}}" alt="{{this.name}}">
  </div>
  <div class="console-card__info">
    <h3 class="console-card__title">{{this.name}}</h3>
    <span class="console-card__year">{{this.year}} · {{this.manufacturer}}</span>
    <span class="console-card__bits">{{this.bitness}}-bit</span>
    <span class="console-card__count">{{this.gamesCount}} игр</span>
  </div>
</a>
